# Copy this file to a private location, edit values, then chmod 600 it.
# Values are literal. No shell expansion, quotes, export, or $HOME substitution.

PAPER_RADAR_WORKSPACE=/absolute/path/to/paper-radar-data

PAPER_RADAR_ALLOW_LIVE_SOURCE=true
PAPER_RADAR_ALLOW_LIVE_MODEL=true
PAPER_RADAR_ALLOW_LIVE_MAIL=true

PAPER_RADAR_PROFILE_DOMAINS=deep_learning,machine_learning,statistics,badminton,male_reproductive_urology
PAPER_RADAR_PROFILE_SCOPE=關注深度學習、機器學習、統計、羽球，以及男性生殖學／泌尿科醫學的新論文。

PAPER_RADAR_OPENROUTER_API_KEY=replace-with-openrouter-api-key
PAPER_RADAR_MODEL_MONTHLY_BUDGET_USD=2.00

PAPER_RADAR_RECIPIENT_EMAIL=you@example.com
PAPER_RADAR_SMTP_HOST=smtp.example.com
PAPER_RADAR_SMTP_PORT=465
PAPER_RADAR_SMTP_SECURITY=ssl
PAPER_RADAR_SMTP_SENDER=paper-radar@example.com
PAPER_RADAR_SMTP_USERNAME=mailer@example.com
PAPER_RADAR_SMTP_PASSWORD=replace-with-smtp-password

PAPER_RADAR_DIGEST_TIMEZONE=Asia/Taipei
PAPER_RADAR_DIGEST_LOCAL_TIME=08:00
# Legacy subscription field; production selection does not truncate to top-N.
PAPER_RADAR_DIGEST_MAX_ITEMS=100

PAPER_RADAR_POLL_SECONDS=60
PAPER_RADAR_MAX_NEW_JOBS=20
PAPER_RADAR_MAX_JOBS=20
PAPER_RADAR_LEASE_SECONDS=300
